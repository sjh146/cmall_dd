# Frontend Dockerfile
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the application
# VITE_API_BASE_URL를 명시적으로 고정 — 미설정 시 import.meta.env 치환이
# 번들에서 API_BASE_URL 선언 유실로 이어져 모든 API 호출이 ReferenceError로 실패함 (실측).
# same-origin(/api/v1, nginx 프록시)이 기본 — 외부 고객 접속 필수값.
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
# WalletConnect/임베디드 지갑 (Reown Cloud projectId — 미설정 시 해당 버튼 숨김)
ARG VITE_WALLETCONNECT_PROJECT_ID=
ENV VITE_WALLETCONNECT_PROJECT_ID=$VITE_WALLETCONNECT_PROJECT_ID
RUN npm run build

# Production image
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/build /usr/share/nginx/html

# Copy nginx config
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]